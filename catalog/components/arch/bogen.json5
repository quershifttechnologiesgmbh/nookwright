  id: "arch/bogen",
  kind: "static",
  name: "Bogen",
  category: "architecture",
  tags: ["bogen", "arch", "gateway", "outdoor"],
  styleTags: ["dwarven", "medieval", "noble"],
  obtainability: "survival",
  mount: "floor",
  rotations: "all",
  variants: [
    {
      // 5 breit, 3 breite Öffnung
