        ["PqSKSpP"], // y3: Bogenring mit Schlussstein
      ],
      legend: {
        P: { role: "wall_primary", shape: "block" },
        q: { role: "wall_primary", shape: "stairs", orient: { upsideDown: true, back: "left" } },
