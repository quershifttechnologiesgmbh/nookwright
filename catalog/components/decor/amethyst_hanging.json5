        A: { block: "minecraft:amethyst_cluster", orient: { front: "down" } },
        M: { block: "minecraft:amethyst_block" },
        C: { role: "metal", shape: "chain", orient: { axis: "y" } },
      },
      masks: { support: [{ at: [0, 2, 0], side: "up", kind: "center" }] },
      stretch: { layer: 1, max: 8, fill: "drop", rows: ["C"] },
    },
  ],
