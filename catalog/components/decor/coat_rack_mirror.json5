  id: "decor/coat_rack_mirror",
  kind: "static",
  name: "Garderobenleiste mit Spiegel",
  category: "attachment",
  tags: ["entryway", "coat_rack_mirror"],
  styleTags: ["medieval", "rustic", "cozy"],
  obtainability: "survival",
  mount: "wall",
  wallHeight: 1,
  rotations: "backToWall",
  layers: [
    ["FsF"], // y0: zwei Haken links und rechts, dazwischen ein Konsolebrett
