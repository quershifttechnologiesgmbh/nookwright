      legend: {
        n: { block: "minecraft:stone_brick_slab", orient: { upsideDown: false } },
        S: { role: "garden_soil", shape: "block" },
        f: { role: "flower_warm", shape: "block" },
      },
    },
    {
      id: "long_herbs",
      weight: 2,
      layers: [
        ["nnnnn", "nSSSn", "nnnnn"],
        [".....", ".ggg.", "....."],
      ],
      legend: {
        n: { block: "minecraft:stone_brick_slab", orient: { upsideDown: false } },
        S: { role: "garden_soil", shape: "block" },
        g: { role: "grass_tuft", shape: "block" },
      },
    },
    {
