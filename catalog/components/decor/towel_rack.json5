      id: "hook",
      weight: 2,
      layers: [
        ["FF", "._"], // y0: zwei Pfosten; vor dem rechten Luft (das Tuch hängt hinein)
        ["wF", ".V"], // y1: Tuch auf dem Pfosten | hoher Pfosten mit Tuch vorn
      ],
      legend: {
        F: { role: "furniture_wood", shape: "fence" },
        w: { block: "minecraft:white_carpet" },
