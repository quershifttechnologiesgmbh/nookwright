  id: "decor/towel_rack",
  kind: "static",
  name: "Handtuchhalter",
  category: "decor",
  tags: ["towel_rack", "bath_decor"],
  styleTags: ["medieval", "rustic"],
  obtainability: "survival",
  mount: "floor",
  rotations: "backToWall",
  variants: [
    {
