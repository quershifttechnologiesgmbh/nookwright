  id: "exterior/door_portal",
  kind: "static",
  name: "Portal",
  category: "architecture",
  tags: ["exterior", "exterior_entrance", "outdoor"],
  styleTags: ["medieval", "noble"],
  obtainability: "survival",
  mount: "facade",
