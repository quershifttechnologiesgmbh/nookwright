      layers: [["......"], ["......"], ["L....L"], ["F....F"]],
      legend: {
        L: { role: "light_hanging", shape: "lantern", orient: { hanging: true } },
        F: { role: "beam", shape: "fence" },
      },
      masks: { support: [{ at: [0, 2, 0], side: "up", kind: "center" }, { at: [5, 2, 0], side: "up", kind: "center" }] },
    },
    {
      id: "double_lanterns_post",
      layers: [["......"], ["P....P"], ["L....L"]],
      legend: {
