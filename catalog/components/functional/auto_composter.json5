      layers: [
        ["HB"], // y0: Trichter (→ Fass) | Knochenmehl-Fass
        ["KR"], // y1: Komposter | Vorrats-Fass
        ["I."], // y2: Einfüll-Trichter (↓ Komposter)
      ],
      legend: {
        H: { block: "minecraft:hopper", orient: { attachTo: "left" } },
        B: { block: "minecraft:barrel", orient: { front: "front" } },
        K: { block: "minecraft:composter" },
        R: { block: "minecraft:barrel", orient: { front: "front" } },
        I: { block: "minecraft:hopper", orient: { attachTo: "down" } },
      },
    },
    {
