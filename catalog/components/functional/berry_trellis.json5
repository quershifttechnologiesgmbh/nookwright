  category: "work",
  tags: ["crop_plot", "farm_bed"],
  functionTags: ["farm:crops", "light"],
  styleTags: ["rustic", "medieval"],
  obtainability: "survival",
  mount: "floor",
  rotations: [0],
  variants: [
    {
      id: "berries_ripe",
      weight: 3,
      layers: [
        ["FFF", "FFF", "FFF"],
        ["BBB", "BLB", "BBB"],
      ],
      legend: {
        F: { block: "minecraft:farmland", state: { moisture: "7" } },
