      id: "with_fence",
      weight: 2,
      layers: [
        ["fFf", "FFF", "fFf"], // y0: Zaun-Ecken | Ackerland
        ["_B_", "BLB", "_B_"], // y1: Luft über den Pfosten, Beeren + Laterne über dem Ackerland
      ],
      legend: {
        f: { role: "beam", shape: "fence" },
        F: { block: "minecraft:farmland", state: { moisture: "7" } },
        L: { block: "minecraft:lantern", orient: { hanging: false }, state: { waterlogged: "true" } },
