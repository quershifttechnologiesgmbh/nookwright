        b: { block: "minecraft:barrel", orient: { front: "up" } },
        K: { role: "beam", shape: "button", orient: { attachTo: "down", front: "front" } },
      },
      sockets: [
        { id: "top_a", type: "surface", at: [0, 1, 1], accepts: ["mug", "tabletop_small"], prob: 0.6, pairWith: "top_b" },
        { id: "top_b", type: "surface", at: [7, 1, 1], accepts: ["mug", "tabletop_small"], prob: 0.6 },
        { id: "top_c", type: "surface", at: [3, 1, 1], accepts: ["mug", "tabletop_small"], prob: 0.5, pairWith: "top_d" },
        { id: "top_d", type: "surface", at: [4, 1, 1], accepts: ["mug", "tabletop_small"], prob: 0.5 },
        { id: "lamp_a", type: "hang", at: [1, 99, 1], accepts: ["light_pendant"], prob: 0.5, pairWith: "lamp_b" },
        { id: "lamp_b", type: "hang", at: [6, 99, 1], accepts: ["light_pendant"], prob: 0.5 },
      ],
    },
    {
      id: "low",
      weight: 1,
      // Kompaktform für lichte Höhe 2: Crafter auf dem Boden, Ausgabe-Trichter seitlich in ein Fass (Zufuhr-Fass darüber)
      layers: [
        ["HC", "OT"], // y0: Zufuhr-Trichter (→ Crafter) | Crafter; vorn Ausgabe-Fass | Ausgabe-Trichter (→ Fass)
        ["bK", "__"], // y1: Vorrats-Fass | Knopf auf dem Crafter
      ],
      legend: {
        H: { block: "minecraft:hopper", orient: { attachTo: "left" } },
        C: { block: "minecraft:crafter", orient: { front: "front" } },
        O: { block: "minecraft:barrel", orient: { front: "up" } },
        T: { block: "minecraft:hopper", orient: { attachTo: "right" } },
        b: { block: "minecraft:barrel", orient: { front: "up" } },
        K: { role: "beam", shape: "button", orient: { attachTo: "down", front: "front" } },
      },
    },
  ],
  masks: { use: [{ side: "front" }], clearance: [{ side: "front", depth: 1, hard: true }] },
  light: "auto",
}
