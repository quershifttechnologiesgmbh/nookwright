  id: "functional/fn_line_brew_street",
  kind: "static",
  name: "Brau-Straße",
  category: "work",
  tags: ["fn_brew_street", "fn_line"],
  functionTags: ["brew", "store", "automation", "work:cleric", "work:leatherworker"],
