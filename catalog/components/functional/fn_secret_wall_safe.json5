// FN-Geheimnisse · Wand-Tresor mit Attrappen-Hebeln: ein Fass (öffnet auch unter Vollblöcken, anders als die Truhe) sitzt
// hinter einem Wandblock, den EIN Klebekolben seitlich in die Tasche zieht. Drei Hebel stehen nebeneinander – nur der
// äußere linke ist verdrahtet, die beiden anderen sitzen auf Blöcken, die an keinen Verbraucher grenzen (Attrappen).
// Das „Rätsel“ ist also: den richtigen Hebel finden (eine Logik-Verknüpfung mehrerer Hebel wäre ohne Spielprüfung
// zu riskant und ist NICHT enthalten; siehe plan/spikes/FN_secrets.md).
//
// RUHEZUSTAND (Export) = ZU: echter Hebel AN, Kolben ausgefahren + Kolbenkopf, Attrappen AUS.
// Mechanik wie `fn_secret_bookcase`: Hebel auf dem Sockelblock speist den Sockel stark, der Kolben grenzt an ihn.
// Klebekolben zieht genau einen Block (Flügel) von x2 nach x1; Schiebelimit 12 nicht berührt.
//
// SICHERHEIT: Nichts Begehbares wird verschlossen (die Öffnung ist ein Block hoch, hinten das Fass). Nische vor dem
// Tresor ist 1×2 offen. Kein Ersticken, kein Einsperren möglich.
//
// Größe 6×3×3 (B×H×T), Blick +z: z0 Wand, z1 Tresor/Kolbenebene, z2 Frontreihe mit Hebeln.
{
  id: "functional/fn_secret_wall_safe",
  kind: "static",
  name: "Wand-Tresor mit Attrappen-Hebeln",
  category: "architecture",
  tags: ["fn_secret_safe", "fn_lever_safe"],
  functionTags: ["fn_secret"],
  styleTags: ["medieval", "noble"],
  obtainability: "survival",
  mount: "floor",
  rotations: "all",
  minRoomHeight: 3,
  layers: [
    [
      "WWWBWW", // y0 z0: Wand | Wand | Fass (Beute) | Wand | Wand
      "WPHSWW", // y0 z1 (Kolbenebene): Klebekolben | Kopf | Flügel | Wand | Wand
      "WKC_KW", // y0 z2 (vorn): Sockel (echter Hebel) | Attrappen-Sockel | Nische | Attrappen-Sockel | Wand
    ],
    [
      "WWWWWW",
      "WWWWWW",
      "Wvw_wW", // y1 z2: echter Hebel (an) | Attrappe | Nische | Attrappe | Wand
    ],
    ["WWWWWW", "WWWWWW", "WWWWWW"], // y2: Sturz
  ],
  legend: {
    P: { block: "minecraft:sticky_piston", orient: { front: "left" }, state: { extended: "true" } },
    H: { block: "minecraft:piston_head", orient: { front: "left" }, state: { type: "sticky", short: "false" } },
    S: { role: "wall_primary", shape: "block" },
    W: { role: "wall_primary", shape: "block" },
    K: { role: "wall_cornice", shape: "block" },
    C: { role: "wall_cornice", shape: "block" },
    v: { block: "minecraft:lever", orient: { attachTo: "down", front: "front" }, state: { powered: "true" } },
    w: { block: "minecraft:lever", orient: { attachTo: "down", front: "front" }, state: { powered: "false" } },
    B: { block: "minecraft:barrel", orient: { front: "front" }, contents: { lootTable: "minecraft:chests/village/village_plains_house" } },
  },
  masks: { use: [{ side: "front" }] },
}
