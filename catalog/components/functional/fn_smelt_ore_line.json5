// Erzstraße (FN, Welle 28.09.2026): Sortierung nach Rohstoff durch beschriftete Bahnen – Eingabefass, Hochofen und Ausgabe-Truhe je
// Rohstoff (Eisen, Gold, Kupfer; die vierte Bahn ist ein Ofen für Stein), gemeinsame Brennstoff-Leitung ohne Redstone.
// Wächst mit der Bahnenzahl (2, 3, 4 Bahnen; Breite 2N + 1, Tiefe 3, Höhe 5).
// Mechanik wie `fn_smelt_bank` (Abgriff = Trichter ↓ unter dem Leitungs-Trichter). Kein Auto-Sortierer: den Rohstoff sortiert der
// Spieler beim Einfüllen (Rahmen am Fass zeigt die Sorte); ein selbst sortierendes Eingangsband wäre ein Komparator-Sortierer
// pro Sorte (`functional/item_sorter`) und bleibt eine Folgeaufgabe. Ruhezustand im Export: Brennstofffass gefüllt, Eingabefässer
// leer, Truhen leer. Über den Truhen bleibt Luft. Nicht im Spiel geprüft: siehe plan/spikes/FN_schmelzanlagen.md.
{
  id: "functional/fn_smelt_ore_line",
  kind: "static",
  name: "Erzstraße (sortierte Schmelzbahnen)",
  category: "work",
  tags: ["fn_smelt", "fn_smelt_ore_line"],
  functionTags: ["smelt", "store", "automation", "sort"],
  styleTags: ["workshop", "dwarven"],
  obtainability: "survival",
  mount: "floor",
  rotations: "backToWall",
  light: "auto",
  variants: [
    {
      // S: zwei Bahnen (Eisen, Gold)
      id: "lanes_2",
      weight: 2,
      minRoomHeight: 5,
      layers: [
        [
          "PSPSP", // Sockel
          "PHPHP", // Sammeltrichter je Bahn (→ Truhe)
          "PCPCP", // Ausgabe-Truhen (je Rohstoff)
        ],
        [
          "PHPHP", // Brennstoff-Trichter (→ Ofen-Seite)
          "PFPFP", // Hochöfen (Bahn 4: Ofen für Stein)
          "P_P_P", // Luft über den Truhen
        ],
        [
          "PDPDP", // Abgriffe Brennstoff (↓)
          "PDPDP", // Eingabe-Trichter je Bahn (↓ Ofen)
          ".....", // 
        ],
        [
          "PLLDP", // Brennstoff-Leitung → nach links (+x)
          "PbPbP", // Eingabefässer (beschriftet)
          "._._.", // Luft für die Rahmen
        ],
        [
          "TBUUT", // Brennstofffass (x = 1), Deckband, Laternen auf den End-Pfeilern
          "T_T.T", // Laternen auf den Pfeilern
          ".....", // 
        ],
      ],
      legend: {
        P: { role: "wall_quoin", shape: "block" },
        S: { role: "foundation", shape: "block" },
        C: { block: "minecraft:chest", orient: { front: "front" } },
        H: { block: "minecraft:hopper", orient: { attachTo: "front" } },
        F: { block: "minecraft:blast_furnace", orient: { front: "front" }, state: { lit: "true" } },
        D: { block: "minecraft:hopper", orient: { attachTo: "down" } },
