// K3d · Thron (research/11 R-1, TH1/TH2): Sitz aus einer Treppe, offene Falltüren als Armlehnen, hohe Lehne aus
// Planken, Krone aus Goldblock. Kompaktform der Thron-Familie (Tag `throne`); die großen Formen mit Podest sind
// arch/throne_dais. „posts“: Lehne zwischen zwei Stamm-Pfosten mit Kerzen (braucht 3 Zellen feste Wand),
// „narrow“: nur die Lehne steht an der Wand (1 Zelle) – passt auch zwischen eng gesetzte Fenster; „chair“ =
// Thronsessel ohne Armlehnen (1 × 2), die Kompaktform für kleine Räume mit Fenstern in jeder Wand.
// Woll-Sitz (26.3) fehlt bewusst (Katalog muss in 1.21.11 und 26.3 materialisieren). Über dem Sitz Luft.
// „*_low“ für lichte Höhe 2 (Krone direkt unter der Decke).
{
  id: "seat/throne",
  kind: "static",
  name: "Thron",
  category: "furniture",
  tags: ["throne", "seat"],
  functionTags: ["sit"],
  styleTags: ["medieval", "noble"],
  obtainability: "survival",
  mount: "floor",
  rotations: "backToWall",
  variants: [
    {
      id: "posts",
      weight: 3,
      minRoomHeight: 3,
      layers: [
        ["PBP", "aSA"], // y0: Pfosten | Lehne | Pfosten; vorn Armlehne | Sitz | Armlehne
        ["PBP", "._."], // y1: hohe Lehne, Luft über dem Sitz
        ["KgK", "..."], // y2: Kerzen auf den Pfosten, Goldkrone
