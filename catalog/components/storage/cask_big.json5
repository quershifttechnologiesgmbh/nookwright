    B: { block: "minecraft:barrel", orient: { front: "front" }, contents: { lootTable: "minecraft:chests/village/village_plains_house" } },
    a: { role: "furniture_wood", shape: "stairs", orient: { upsideDown: true, back: "left" } },
    b: { role: "furniture_wood", shape: "stairs", orient: { upsideDown: true, back: "right" } },
    c: { role: "furniture_wood", shape: "stairs", orient: { back: "left" } },
    d: { role: "furniture_wood", shape: "stairs", orient: { back: "right" } },
  },
  sockets: [{ id: "keg", type: "above", at: [1, 3, 0], accepts: ["stack_on_barrel"], prob: 0.5 }],
  masks: { use: [{ side: "front" }] },
