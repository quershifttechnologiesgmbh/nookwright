// K3b · Stückfass (research/17 §4.20, V5/V6): 3 × 3-Stirnseite mit „runden“ Ecken aus Treppen, in der Mitte ein
// Fass als Spund (echter Behälter, öffnet immer, Faktencheck #2), dahinter Planken. Treppen-Ecken mit der Lehne
// zur Mitte (left = +x): so fehlt die äußere Ecke, die Stirn wirkt rund. Fass = Fischer-Arbeitsblock
// (Faktencheck #7) → `villager_workstation`. Mehr in die Höhe (V3): auf dem Fass stehen Fässchen gestapelt
// (Socket `above`, Tag `stack_on_barrel`), bis die Decke kommt. Zapfhahn (Stolperdrahthaken) fehlt, bis die
// Physik seine Stützregel kennt (K2 §5).
{
  id: "storage/cask_big",
  kind: "static",
  name: "Stückfass",
  category: "storage",
  tags: ["cask_big", "cask"],
  functionTags: ["store", "villager_workstation", "work:fisherman"],
  styleTags: ["medieval", "rustic"],
  obtainability: "survival",
  mount: "floor",
  rotations: "backToWall",
  layers: [
    ["PPP", "aPb"], // y0: hinten Planken; vorn untere Ecken (umgedrehte Treppen)
    ["PPP", "PBP"], // y1: vorn das Fass als Spund
    ["PPP", "cPd"], // y2: vorn obere Ecken
  ],
  legend: {
