      layers: [
        ["KB", ".K"],
        ["BB", ".B"],
        ["Lc", ".c"],
      ],
      legend: {
        B: { block: "minecraft:bookshelf" },
        K: { block: "minecraft:barrel", orient: { front: "front" } },
        c: { block: "minecraft:candle", state: { candles: "2", lit: "true" } },
        L: { role: "light_hanging", shape: "lantern", orient: { hanging: false } },
      },
      stretch: { layer: 1, max: 12, fill: "ceiling" },
    },
    {
      id: "corner_r_low",
      weight: 2,
      maxRoomHeight: 2,
      layers: [["BK", "K."], ["BB", "B."]],
      legend: {
        B: { block: "minecraft:bookshelf" },
        K: { block: "minecraft:barrel", orient: { front: "front" } },
      },
    },
    {
      id: "corner_l_low",
