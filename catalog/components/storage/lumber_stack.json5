  id: "storage/lumber_stack",
  kind: "static",
  name: "Bretterstapel",
  category: "storage",
  tags: ["lumber_stack", "woodwork"],
  styleTags: ["medieval", "rustic"],
  obtainability: "survival",
  mount: "floor",
  rotations: "backToWall",
  variants: [
    {
      id: "low",
      weight: 2,
      layers: [["LLL"], ["sss"]],
      legend: {
        L: { role: "beam", shape: "log", orient: { axis: "across" } },
        s: { role: "furniture_wood", shape: "slab", orient: { upsideDown: false } },
      },
    },
    {
      id: "tall",
      weight: 2,
      layers: [["LLL"], ["sss"], ["LL."]],
      legend: {
