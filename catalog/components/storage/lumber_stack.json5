        s: { role: "furniture_wood", shape: "slab", orient: { upsideDown: false } },
      },
    },
    {
      // Holzlager bis zur Decke: Stämme, Bretter, Stämme (gedehnt), oben Bretter
      id: "high",
      weight: 3,
      minRoomHeight: 4,
      layers: [["LLL"], ["sss"], ["LLL"], ["ss."]],
      legend: {
        L: { role: "beam", shape: "log", orient: { axis: "across" } },
        s: { role: "furniture_wood", shape: "slab", orient: { upsideDown: false } },
