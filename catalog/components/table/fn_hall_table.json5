// FN · Hallentafel (Innenraum-Offensive, Methalle/Taverne/Speisesaal): lange Tafel (7 bzw. 9 Blöcke) mit Bänken auf
// beiden Längsseiten und Böcken an den Stirnseiten, wie die Festtafel table/trestle_table, aber gestreckt, damit die
// Hallenachse eine echte Tafel bekommt (Community-Methallen: eine lange Tafel zwischen zwei Sitzreihen, darüber
// Hängelaternen im Takt). Oben Krüge, Kerzen, Essen; über der Tafel Hänge-Sockets für Laternen. Tag `fn_hall_table`.
{
  id: "table/fn_hall_table",
  kind: "static",
  name: "Hallentafel",
  category: "furniture",
  tags: ["fn_hall_table"],
  functionTags: ["sit"],
  styleTags: ["medieval", "nordic", "rustic"],
  obtainability: "survival",
  mount: "floor",
  rotations: [0, 1],
  variants: [
    // Schmale Tafel ohne Bänke (1 tief): passt zwischen zwei Fellpritschen-Reihen, die Pritschen dienen als Sitz
    {
      id: "spine7",
      weight: 3,
      layers: [["PTTTTTP"]],
      legend: {
        P: { role: "beam", shape: "log", orient: { axis: "y" } },
        T: { role: "furniture_wood", shape: "slab", orient: { upsideDown: true } },
