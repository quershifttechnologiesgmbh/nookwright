// K3a · Schreibtisch vor der Bücherwand (research/17 §4.8, S1/S3): 3 × 3, Rücken zur Wand. Hinten die Bücherwand,
// in der Mitte der Stuhl (Lehne zur Wand → Blick über den Tisch zur Tür), vorn die Tischplatte wie die Festtafel
// (umgedrehte Treppen als Wangen, obere Stufe). Die Zellen neben dem Stuhl bleiben frei (Zugang von der Seite).
// Tischdeko über Sockets. V3 „mehr in die Höhe“: ab lichter Höhe 4 reicht die Bücherwand bis unter die Decke
// (`stretch`, `ceiling`) mit Gesims; darüber eine Hängelaterne über der Platte (`hang`, V3). Kein Tag `desk`
// (research/17 §7.2): Schlafzimmer und Turmzimmer sollen den großen Tisch nicht ziehen.
{
  id: "table/study_desk",
  kind: "static",
  name: "Schreibtisch vor Bücherwand",
  category: "furniture",
  tags: ["study_desk"],
  functionTags: ["sit", "read"],
  styleTags: ["medieval", "noble", "scholarly"],
  obtainability: "survival",
  mount: "floor",
  rotations: "backToWall",
  variants: [
    {
      id: "shelves",
      weight: 2,
      minRoomHeight: 3,
      maxRoomHeight: 3,
      layers: [
        ["BBB", "_C_", "WTE"], // y0: Regale | Stuhl mit freien Seiten | Tischplatte
        ["BBB", "_._", "..."], // y1
