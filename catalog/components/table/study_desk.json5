    { id: "desk_r", type: "surface", at: [2, 1, 2], accepts: ["plant", "tabletop_small"], prob: 0.5 },
    { id: "lamp", type: "hang", at: [1, 99, 2], accepts: ["light_pendant"], prob: 0.4 }, // V3
