        C: { role: "furniture_wood", shape: "stairs", orient: { back: "back" } },
        W: { role: "furniture_wood", shape: "stairs", orient: { upsideDown: true, back: "right" } },
        T: { role: "furniture_wood", shape: "slab", orient: { upsideDown: true } },
        E: { role: "furniture_wood", shape: "stairs", orient: { upsideDown: true, back: "left" } },
        c: { block: "minecraft:candle", state: { candles: "3", lit: "true" } },
      },
    },
    {
      id: "tall",
      weight: 3,
      minRoomHeight: 4,
      layers: [
        ["BBB", "_C_", "WTE"],
        ["BBB", "_._", "..."],
        ["BBB", "...", "..."], // y2: wird bis unter das Gesims gedehnt
        ["KKK", "...", "..."], // oben: Gesims
      ],
      legend: {
        B: { block: "minecraft:bookshelf" },
        C: { role: "furniture_wood", shape: "stairs", orient: { back: "back" } },
        W: { role: "furniture_wood", shape: "stairs", orient: { upsideDown: true, back: "right" } },
        T: { role: "furniture_wood", shape: "slab", orient: { upsideDown: true } },
        E: { role: "furniture_wood", shape: "stairs", orient: { upsideDown: true, back: "left" } },
        K: { role: "furniture_wood", shape: "stairs", orient: { upsideDown: true, back: "back" } },
      },
      stretch: { layer: 2, max: 12, fill: "ceiling" },
    },
    {
      // lichte Höhe 2: Regale 2 hoch, keine Kerzen
      id: "low",
      weight: 1,
      maxRoomHeight: 2,
      layers: [
        ["BBB", "_C_", "WTE"],
        ["BBB", "_._", "..."],
      ],
      legend: {
        B: { block: "minecraft:bookshelf" },
        C: { role: "furniture_wood", shape: "stairs", orient: { back: "back" } },
        W: { role: "furniture_wood", shape: "stairs", orient: { upsideDown: true, back: "right" } },
        T: { role: "furniture_wood", shape: "slab", orient: { upsideDown: true } },
        E: { role: "furniture_wood", shape: "stairs", orient: { upsideDown: true, back: "left" } },
      },
    },
