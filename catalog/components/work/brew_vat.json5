  id: "work/brew_vat",
  kind: "static",
  name: "Braubottich",
  category: "work",
  tags: ["brew_vat", "brewing_beer"],
  styleTags: ["medieval", "rustic"],
  obtainability: "survival",
  mount: "floor",
  rotations: [0, 1],
  variants: [
    {
      id: "wort",
      weight: 3,
      layers: [
        ["PHP", "HHH", "PHP"], // y0: Würze (Honigblöcke), Planken in den Ecken
        ["KNK", "W_E", "KSK"], // y1: Rand aus Falltüren, Mitte offen
      ],
      legend: {
        P: { role: "beam", shape: "planks" },
        H: { block: "minecraft:honey_block" },
        K: { role: "beam", shape: "log", orient: { axis: "y" } },
        N: { role: "beam", shape: "trapdoor", orient: { front: "front", open: true } },
        S: { role: "beam", shape: "trapdoor", orient: { front: "back", open: true } },
        W: { role: "beam", shape: "trapdoor", orient: { front: "left", open: true } },
        E: { role: "beam", shape: "trapdoor", orient: { front: "right", open: true } },
      },
    },
