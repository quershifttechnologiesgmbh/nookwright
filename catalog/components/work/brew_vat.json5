        ["KNK", "WfE", "KSK"], // Rührholz steht in der Würze
        ["...", ".f.", "..."], // und ragt über den Rand
      ],
      legend: {
        P: { role: "beam", shape: "planks" },
        H: { block: "minecraft:honey_block" },
        K: { role: "beam", shape: "log", orient: { axis: "y" } },
        N: { role: "beam", shape: "trapdoor", orient: { front: "front", open: true } },
        S: { role: "beam", shape: "trapdoor", orient: { front: "back", open: true } },
        W: { role: "beam", shape: "trapdoor", orient: { front: "left", open: true } },
