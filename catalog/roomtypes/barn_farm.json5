// FN Tierfarmen (plan/spikes/FN_tierfarmen.md): Zuchtstall / Scheune mit Gehegen. `stable.json5` bleibt unverändert; dieser
// Raumtyp führt die neuen `fn_`-Komponenten ein: Zucht-Gehege (Rind oder Schwein, Größe nach Fläche), Wollfarm mit
// Schere-Spender, Boxenreihe, Hühnerfarm. Pflicht ist ein Zucht-Gehege (kleinste Form 6×5 passt in jeden 30-m²-Raum).
// Tiere bringt der Spieler (kein Spawn im Export); Futter, Scheren und Heu sind vorgeladen. Licht ≥ 5 (Laternen an den Pfosten).
{
  id: "barn_farm",
  name: "Zuchtstall",
  minArea: 64,
  coverage: { target: 0.5 },
  required: [
    { tags: ["fn_breeding_pen"], count: [1, 1], placement: { zones: ["center", "edge"] } },
  ],
  optional: [
    { tags: ["fn_breeding_pen"], count: { perArea: 45, min: 0, max: 2 }, weight: 3, placement: { zones: ["center", "edge"] } },
    { tags: ["fn_wool_farm"], count: [0, 1], weight: 3, placement: { zones: ["center", "edge"] } },
    { tags: ["fn_stable_boxes"], count: [0, 1], weight: 3, placement: { zones: ["edge"] } },
    { tags: ["fn_chicken_farm"], count: [0, 1], weight: 2, placement: { zones: ["edge", "corner"] } },
    { tags: ["barrel", "chest"], count: [0, 2], weight: 2, placement: { zones: ["corner", "edge"] } },
    { tags: ["farm_tools"], count: [0, 2], weight: 2 },
    { tags: ["hay_stack"], count: [0, 2], weight: 3, placement: { zones: ["edge", "corner"] } },
    { tags: ["hanging_chains", "herb_rack"], count: [0, 1], weight: 1 },
    { tags: ["wall_shelf", "tool_wall"], count: [0, 2], weight: 2 },
    { tags: ["light_ceiling", "light_wall"], count: [1, 3], weight: 3 },
  ],
  lighting: { minLevel: 5, prefer: ["light_wall", "light_ceiling"] },
}
