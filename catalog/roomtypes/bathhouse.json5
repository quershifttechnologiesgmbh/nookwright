// Badehaus (research/17 §4.10, B1–B5). K3a. Signatur-Familie `bath_pool`: gemauertes Becken (bath/stone_pool, 3 × 2
// bzw. 4 × 3 Wasser) vor dem Holzzuber (bath/wooden_tub, 2 × 2) als Kompaktform – beide mit unendlicher Wasserquelle
// (Validator-Wunsch Y7 `infiniteWater`). Das eingelassene Becken (bath/sunken_pool) braucht ERW X5 und fehlt.
// Umgang mit Wand- und Sitzbänken, Handtuchhalter, Heißwasserkessel in der Ecke, Grün. minArea 24 statt 20
// (research/17): in 5 × 4 Zellen passt neben dem Zuber kein Umgang zur Tür. V3: Laternen auf Säulchen am Becken,
// Arkaden-Pfeiler bis zur Decke, Hängemoos/Hängegrün, Wand- und Deckenlicht.
{
  id: "bathhouse",
  name: "Badehaus",
  minArea: 24,
  coverage: { target: 0.35 },
  required: [
    { tags: ["bath_pool"], count: [1, 1], signature: true, placement: { zones: ["center"], doorAffinity: "far" } },
  ],
  optional: [
    { tags: ["wall_bench", "table_bench"], count: [1, 3], weight: 4, placement: { zones: ["edge"] } },
    { tags: ["towel_rack", "linen_closet"], count: [1, 2], weight: 3, placement: { zones: ["edge"] } },
    { tags: ["brew_kettle"], count: [0, 1], weight: 2, placement: { zones: ["corner", "edge"] } },
    { tags: ["plant_large", "planter"], count: [1, 3], weight: 3, placement: { zones: ["corner", "edge"] } },
    { tags: ["moss_rug"], count: [0, 2], weight: 1, placement: { zones: ["corner"] } },
    { tags: ["pedestal"], count: [0, 2], weight: 1, placement: { zones: ["corner"] } },
    // V3 (Raumhöhe nutzen): Arkaden-Pfeiler bis zur Decke (B2), Behang, Hängemoos/-grün, Licht an Wand und Decke
    { tags: ["pilaster", "gallery_bay"], count: [2, 6], weight: 3, placement: { zones: ["edge"] }, pattern: { kind: "row", gap: 2 } },
    { tags: ["tapestry", "wall_banner"], count: [0, 2], weight: 2 },
    { tags: ["hanging_moss", "plant_hanging"], count: [1, 3], weight: 2 },
    { tags: ["light_wall"], count: [2, 6], weight: 4 },
    { tags: ["light_ceiling"], count: [1, 2], weight: 2 },
  ],
  lighting: { minLevel: 6, prefer: ["light_wall", "light_ceiling", "candles", "light_floor"] },
}
