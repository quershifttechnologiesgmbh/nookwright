// Schlafzimmer (research/10 §2, §8.1). Signatur Himmelbett (7/13) ist Pflicht: die Familie `canopy_bed`
// enthält eine kompakte Form (bed/canopy_head, Grundfläche 1×2, 2 hoch) für niedrige und kleine Räume.
// Ab ≈ 30 Zellen kommt ein Einzelbett dazu (research: 2 Betten ab ≈ 21 m²; hier vorsichtiger).
// Werkbank entfernt (0/13 Referenzen). Drei Ebenen: Boden (Möbel, Teppich, Kübel), Wand (Behang, Bord),
// Decke (Laterne, Grün).
// K2: dichter (0.5); Sessel/Sitzgruppe am Fenster, Wandteppich und Wandkübel (Wand-Ebene), Anrichte,
// Standuhr. `wardrobe` umfasst jetzt auch den Schrank mit Türen, `rug` Läufer, Fell und runden Teppich.
// I2: Signatur explizit (`signature: true`, Solver v2) statt Konvention „erster Pflicht-Eintrag“.
{
  id: "bedroom",
  name: "Schlafzimmer",
  minArea: 6,
  coverage: { target: 0.5 },
  required: [
    { tags: ["canopy_bed"], count: [1, 1], signature: true, placement: { zones: ["edge", "corner"], doorAffinity: "far" } },
    { tags: ["bed_single"], count: { perArea: 60, min: 0, max: 1 }, placement: { zones: ["edge", "corner"], doorAffinity: "far" } },
  ],
  optional: [
    { tags: ["plant_large"], count: [1, 2], weight: 3, placement: { zones: ["corner", "edge"] } },
    { tags: ["wall_banner", "wall_shelf"], count: [2, 3], weight: 3 },
    { tags: ["wardrobe"], count: [0, 1], weight: 3, placement: { zones: ["edge", "corner"] } },
    // W3-IN: Truhe neben dem Bett an derselben Wand (am Fußende über den Andockpunkt des Himmelbetts)
    { tags: ["chest"], count: [0, 1], weight: 2, placement: { zones: ["edge", "corner"] }, near: { tags: ["canopy_bed", "bed_single"], sameWall: true } },
    { tags: ["desk", "dressing_table"], count: [0, 1], weight: 2, placement: { zones: ["edge"], windowAffinity: "near" } },
    { tags: ["fn_rug", "rug"], count: [1, 1], weight: 4, placement: { zones: ["center"] } },
    { tags: ["plant_hanging"], count: [0, 1], weight: 1 },
    { tags: ["wing_chair", "seating_group"], count: [0, 1], weight: 2, placement: { zones: ["edge", "corner"], windowAffinity: "near" } },
    { tags: ["fn_tapestry", "tapestry", "wall_plant"], count: [0, 2], weight: 3 },
    // FN (Innenraum-Offensive): Ecken belegen (Kübel auf Hocker, Fass mit Kerze)
    { tags: ["fn_corner"], count: [1, 2], weight: 3, placement: { zones: ["corner"] } },
    { tags: ["sideboard", "tall_clock"], count: [0, 1], weight: 1, placement: { zones: ["edge"] } },
    // V3 (Raumhöhe nutzen): Stapel, Wand über Kopfhöhe, Decke (optional, additiv)
    { tags: ["ceiling_banner", "herb_rack"], count: [0, 1], weight: 1 },
    { tags: ["upper_cabinet"], count: [0, 1], weight: 1 },
    // W3-IN (I7): höchstens eine Laterne unter der Decke; das Licht steht am Bett (Nachttisch)
    { tags: ["light_pendant"], count: [0, 1], weight: 3 },
  ],
  // Licht-Pass (W3-IN, I7): Licht am Bett – Kerze bzw. Laterne auf dem Nachttisch, Hängelaterne über/neben dem Bett,
  // dann Wandlaterne (Vorbilder: Hängelaterne am Bett 6/13, Kerzen am Nachttisch 4/13, Wandlaternen 2/13)
  lighting: { minLevel: 6, prefer: ["light_small", "light_pendant", "light_wall"], budget: { cellsPer: 14, min: 1, max: 4 }, anchors: ["nightstand", "canopy_bed", "bed_single", "desk", "dressing_table", "table"] },
}
