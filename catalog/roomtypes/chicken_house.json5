// FN Tierfarmen: Hühnerhaus mit Sammler und (ab lichter Höhe 4) Lava-Garer. Die Hühnerfarm-Komponente hat die Formen `coop`
// (Höhe 2) und `cooker` (Höhe 4); der Solver nimmt bei niedrigen Räumen die niedrige. Das Fass am Ende der Trichterkette
// sammelt Eier (und gegartes Hähnchen). Tiere bringt der Spieler. `egg_collector` bleibt für `stable`/`farm_room`.
{
  id: "chicken_house",
  name: "Hühnerhaus",
  minArea: 64,
  coverage: { target: 0.4 },
  required: [
    { tags: ["fn_chicken_farm"], count: [1, 1], placement: { zones: ["edge", "corner"] } },
  ],
  optional: [
    { tags: ["barrel", "chest"], count: [1, 2], weight: 3, placement: { zones: ["corner", "edge"] } },
    { tags: ["hay_stack"], count: [0, 2], weight: 3, placement: { zones: ["edge", "corner"] } },
    { tags: ["farm_tools"], count: [0, 2], weight: 2 },
    { tags: ["herb_rack", "hanging_chains"], count: [0, 1], weight: 1 },
    { tags: ["wall_shelf", "tool_wall"], count: [0, 2], weight: 2 },
    { tags: ["plant_large"], count: [0, 2], weight: 1, placement: { zones: ["corner", "edge"] } },
    { tags: ["candle_stand"], count: [0, 1], weight: 1, placement: { zones: ["edge", "corner"] } },
    { tags: ["light_ceiling", "light_wall"], count: [1, 3], weight: 3 },
  ],
  lighting: { minLevel: 7, prefer: ["light_wall", "light_ceiling"] },
}
