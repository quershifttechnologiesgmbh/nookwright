// Anbauhalle (Welle FN, Pflanzen-Farmen): halbautomatische Feldfarmen, die mit dem Raum wachsen.
// Pflicht ist der kleine Pflanzkasten (fn_planter, 3x3, passt in jede Halle); die großen Anlagen wachsen mit der Fläche: Spülfeld-Farm
// (fn_crop_flush, Wasserernte + Trichterkette + Fass, ab etwa 9x11 Innenmaß), Kolben-Kürbis-/Melonenfarm, Zuckerrohr-/Bambusreihe,
// Hochbeet-Reihen. Große Hallen setzen mehrere Stücke (count perArea).
// Mechanik-Hinweise stehen in den Komponenten-Kopfkommentaren; Feldfrüchte in geschlossenen Räumen strict platzieren.
// Neuer Raumtyp: fn_-Tags erscheinen in keinem Bestandsraum. farm_room/greenhouse bleiben unverändert.
{
  id: "crop_hall",
  name: "Anbauhalle",
  minArea: 36,
  coverage: { target: 0.6 },
  required: [
    { tags: ["fn_planter"], count: [1, 1], placement: { zones: ["edge", "center"] } },
  ],
  optional: [
    { tags: ["fn_crop_flush"], count: { perArea: 40, min: 1, max: 3 }, weight: 10, signature: true, placement: { zones: ["center", "edge"] } },
    { tags: ["fn_planter"], count: { perArea: 14, min: 0, max: 6 }, weight: 6, placement: { zones: ["edge", "center"] } },
    { tags: ["fn_crop_melon"], count: { perArea: 50, min: 1, max: 2 }, weight: 4, placement: { zones: ["edge"] } },
    { tags: ["fn_crop_cane"], count: [0, 1], weight: 2, placement: { zones: ["edge"] } },
    { tags: ["fn_bed_row"], count: { perArea: 30, min: 1, max: 3 }, weight: 4, placement: { zones: ["edge", "center"] } },
    { tags: ["barrel"], count: [0, 2], weight: 2, placement: { zones: ["corner"] } },
    { tags: ["farm_tools", "decor_scarecrow"], count: [0, 2], weight: 2 },
    { tags: ["hay_stack", "crate_stack", "seed_crate"], count: [0, 2], weight: 2, placement: { zones: ["edge", "corner"] } },
    { tags: ["plant_hanging", "hanging_plant_shelf", "hanging_terrarium"], count: [1, 3], weight: 4 },
    { tags: ["wall_shelf", "tool_wall"], count: [0, 2], weight: 2 },
    { tags: ["light_ceiling"], count: [1, 3], weight: 3 },
  ],
  lighting: { minLevel: 9, prefer: ["light_ceiling", "light_wall", "light_floor"] },
}
