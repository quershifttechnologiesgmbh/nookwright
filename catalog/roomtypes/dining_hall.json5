// K3d · Speisesaal / Bankettsaal (research/11 §6 DH1–DH3; research/17 §5 Delta: Festtafel quer auf dem Podest als
// „High Table“, Kamin an der Längswand, Orgel/Cembalo). Signatur: Bankett-Tafel mit Läufer und hochlehnigen Stühlen
// (Tag `banquet_table`, Länge 7/5/3 je nach Platz) längs der Raummitte; der Hochtisch auf dem Podest steht fern
// der Tür an der Stirnwand. Kronleuchter über den Tafeln (V3: Hängelaternen über der Platte, Kronleuchter an der
// Kette), Kerzenständer an den Wänden, Anrichten, Wandbehänge über Kopfhöhe, verdecktes Kassettenlicht (L1).
// Keine Mittelachse (`aisle`): die Tafeln stehen genau dort.
{
  id: "dining_hall",
  name: "Speisesaal",
  minArea: 36,
  coverage: { target: 0.35 },
  required: [
    { tags: ["banquet_table"], count: [1, 1], signature: true, placement: { zones: ["center"] } },
  ],
  optional: [
    { tags: ["banquet_table"], count: { perArea: 50, min: 0, max: 2 }, weight: 4, placement: { zones: ["center"] } },
    { tags: ["high_table"], count: [0, 1], weight: 4, placement: { zones: ["edge"], doorAffinity: "far" } },
    { tags: ["fireplace"], count: [0, 1], weight: 3, placement: { zones: ["edge"] } },
    { tags: ["sideboard"], count: [0, 2], weight: 3, placement: { zones: ["edge"] } },
    { tags: ["candle_stand"], count: [0, 4], weight: 2, placement: { zones: ["edge", "corner"] } },
    { tags: ["keyboard_instrument", "music"], count: [0, 1], weight: 1, placement: { zones: ["corner", "edge"] } },
    // FN: Wandpfeiler (`pilaster`) im Takt statt `column` – der Tag `column` trifft auch das Deckenbalken-Gitter
    // (architecture/ceiling_coffer_beam_grid), das in der Halle als schwebender Holzring wirkte, und die freie Säule stand
    // mitten zwischen den Tafeln (Bericht: Kreuzform wirkte wie ein Klotz auf dem Tisch)
    { tags: ["pilaster"], count: { perArea: 30, min: 0, max: 4 }, weight: 2, placement: { zones: ["edge"] }, pattern: { kind: "row", gap: 3 } },
    { tags: ["room_divider"], count: [0, 1], weight: 1, placement: { zones: ["center"] } },
    { tags: ["plant_large"], count: [0, 2], weight: 1, placement: { zones: ["corner"] } },
    // Wand und Decke (über Kopfhöhe)
    { tags: ["fn_tapestry", "wall_banner", "tapestry"], count: [2, 4], weight: 4 },
    // FN (Innenraum-Offensive): Ecken belegen, Teppichinsel vor dem Hochtisch/Kamin
    { tags: ["fn_corner"], count: [1, 3], weight: 4, placement: { zones: ["corner"] } },
    { tags: ["fn_rug"], count: [0, 1], weight: 2, placement: { zones: ["edge"] } },
    { tags: ["wall_panel", "wall_food"], count: [1, 3], weight: 2 },
    { tags: ["upper_cabinet", "wall_shelf", "mantel_shelf_display"], count: [0, 2], weight: 1 },
    { tags: ["ceiling_banner"], count: [0, 2], weight: 2 },
    { tags: ["chandelier"], count: { perArea: 30, min: 1, max: 4 }, weight: 4 },
    { tags: ["light_hidden"], count: [0, 2], weight: 2 },
  ],
  // W3-IN (I7): Laternenreihe über der Tafel, Kerzen auf der Tafel, Kronleuchter, Laternen an den Wänden; Budget je Fläche
  lighting: { minLevel: 7, prefer: ["light_pendant", "candles", "chandelier", "light_wall"], budget: { cellsPer: 12, min: 3 }, anchors: ["banquet_table", "high_table", "sideboard"] },
}
