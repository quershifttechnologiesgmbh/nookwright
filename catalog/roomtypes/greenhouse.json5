// K3d · Gewächshaus (research/11 §7 G1–G6; research/17 §5 Delta). Anders als die Innenfarm (farm_room, Feldfrüchte
// mit Bewässerungs-Laterne) ein Zier- und Pflanzgarten: Hochbeete mit Falltür-Einfassung und Blumen (Signatur,
// Tag `garden_bed`), Pflanzen-Etageren auf 1–3 Ebenen (V3: je nach lichter Höhe, mit Leiter), Pflanztisch mit
// Komposter, Kübelbäume, Hängetöpfe und Kräuter von der Decke, Wandkübel. Blumen brauchen kein Licht; das Ziel
// ≥ 8 ist Stimmung. Glaswände/Glasdach (Hülle, research/11 „roleOverrides“) fehlen noch → Bericht K3d.
{
  id: "greenhouse",
  name: "Gewächshaus",
  minArea: 20,
  coverage: { target: 0.45 },
  required: [
    // Signatur: Hochbeet; in sehr kleinen Räumen ist der Pflanztrog (decor/planter_trough) die Kompaktform
    { tags: ["garden_bed", "planter"], count: [1, 1], signature: true, placement: { zones: ["center", "edge"] } },
  ],
  optional: [
    // weitere Beete je nach Fläche (optional: zwei Pflicht-Beete sprengen kleine Räume, wie farm_room)
    { tags: ["garden_bed"], count: { perArea: 24, min: 0, max: 3 }, weight: 4, placement: { zones: ["center", "edge"] } },
    { tags: ["plant_shelf"], count: [1, 3], weight: 4, placement: { zones: ["edge"], windowAffinity: "near" } },
    { tags: ["potting_bench"], count: [0, 1], weight: 3, placement: { zones: ["edge", "corner"] } },
    // Q1b (research/57 §4.4): bis 4 statt 3, damit `decor/vine_trellis` neben `leaf_planter`/`planter_trough`/
    // `potted_tree`/`moss_corner_planter` in großen Häusern wirklich zusammen auftaucht statt sich zu verdrängen.
    { tags: ["plant_large", "moss_corner_planter", "vine_trellis"], count: [1, 4], weight: 3, placement: { zones: ["corner", "edge"] } },
    { tags: ["planter"], count: [0, 2], weight: 2, placement: { zones: ["edge", "center"] } },
    { tags: ["water_cauldron"], count: [0, 1], weight: 1, placement: { zones: ["edge"] } },
    { tags: ["barrel"], count: [0, 1], weight: 1, placement: { zones: ["corner"] } },
    { tags: ["moss_rug"], count: [0, 2], weight: 1 },
    // Wand und Decke (über Kopfhöhe)
    { tags: ["wall_plant", "moss_corner_planter"], count: [0, 2], weight: 2 },
    { tags: ["plant_hanging", "hanging_plant_shelf", "hanging_terrarium"], count: [1, 4], weight: 4 },
    { tags: ["herb_rack"], count: [0, 2], weight: 2 },
    { tags: ["light_ceiling"], count: [1, 3], weight: 3 },
    { tags: ["light_hidden"], count: [0, 2], weight: 2 },
  ],
  lighting: { minLevel: 8, prefer: ["light_ceiling", "light_hidden", "light_wall", "light_floor"] },
}
