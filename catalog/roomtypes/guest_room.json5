    { tags: ["wardrobe"], count: [0, 1], weight: 3, placement: { zones: ["edge", "corner"] } },
    { tags: ["washstand"], count: [0, 1], weight: 3, placement: { zones: ["edge"], doorAffinity: "near" } },
