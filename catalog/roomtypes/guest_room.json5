  id: "guest_room",
  name: "Gästezimmer",
  minArea: 9,
  coverage: { target: 0.45 },
  required: [
    { tags: ["bed_single"], count: [2, 2], signature: true, placement: { zones: ["edge"], doorAffinity: "far" }, pattern: { kind: "row", gap: 1 } },
  ],
  optional: [
