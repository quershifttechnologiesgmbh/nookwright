    { tags: ["plant_large"], count: [0, 1], weight: 3, placement: { zones: ["corner"] } },
    { tags: ["fn_runner", "rug"], count: [0, 1], weight: 3, placement: { zones: ["center"] } },
    // FN (Innenraum-Offensive): Ecke belegen, Wandbehang an der Stirnwand
    { tags: ["fn_corner"], count: [0, 1], weight: 2, placement: { zones: ["corner"] } },
    { tags: ["light_wall", "light_ceiling"], count: [1, 2], weight: 4 },
  ],
  lighting: { minLevel: 7, prefer: ["light_wall", "light_ceiling", "candles", "light_floor"] },
}
