// Kräuter- und Beetgarten für Wohnhäuser, Höfe und Wintergärten (Welle FN): Pflanzkasten (fn_planter, Pflicht, 3x3) und Hochbeet-Reihen (fn_bed_row, Laterne =
// Wasser + Licht), Kräuterregale (fn_herb_rack, Töpfe), Leuchtbeeren-Vorhang als Lichtquelle, kleine Kolbenfarm optional.
// Etwas kleiner als crop_hall (minArea 30 statt 36): passt in Kammern und Anbauten. Neuer Raumtyp, nur fn_-Tags plus bekannte Dekoration.
{
  id: "herb_garden",
  name: "Kräutergarten",
  minArea: 30,
  coverage: { target: 0.5 },
  required: [
    { tags: ["fn_planter"], count: [1, 1], placement: { zones: ["edge", "center"] } },
  ],
  optional: [
    { tags: ["fn_bed_row"], count: { perArea: 24, min: 0, max: 3 }, weight: 6, signature: true, placement: { zones: ["edge", "center"] }, pattern: { kind: "row", gap: 1 } },
    { tags: ["fn_planter"], count: { perArea: 14, min: 0, max: 4 }, weight: 4, placement: { zones: ["edge", "center"] } },
    { tags: ["fn_herb_rack"], count: { perArea: 20, min: 1, max: 3 }, weight: 4, placement: { zones: ["edge"] } },
    { tags: ["fn_glow_vines"], count: [0, 1], weight: 2, placement: { zones: ["edge"] } },
    { tags: ["fn_crop_melon"], count: [0, 1], weight: 1, placement: { zones: ["edge"] } },
    { tags: ["barrel"], count: [0, 2], weight: 2, placement: { zones: ["corner"] } },
    { tags: ["farm_tools", "decor_scarecrow"], count: [0, 1], weight: 2 },
    { tags: ["plant_hanging", "hanging_plant_shelf", "hanging_terrarium"], count: [1, 3], weight: 4 },
    { tags: ["plant_large"], count: [0, 2], weight: 2, placement: { zones: ["corner", "edge"] } },
    { tags: ["candle_stand"], count: [0, 1], weight: 1, placement: { zones: ["edge", "corner"] } },
    { tags: ["vase"], count: [0, 1], weight: 1, placement: { zones: ["corner", "edge"] } },
    { tags: ["wall_shelf"], count: [0, 2], weight: 2 },
    { tags: ["light_ceiling"], count: [1, 2], weight: 2 },
  ],
  lighting: { minLevel: 9, prefer: ["light_ceiling", "light_wall", "light_floor"] },
}
