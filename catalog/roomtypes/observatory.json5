// Observatorium (research/17 §4.28, O1–O4). K3a. Signatur: Teleskop am Fenster bzw. in der Raummitte (astro/telescope,
// das große Fernrohr ab lichter Höhe 4). Sternenhimmel an der Decke (astro/star_cluster: Endstäbe und Amethyst),
// Armillarsphäre, Kartentisch (work/map_desk, research/11) oder Lesetisch, Regale, Lesepult, Kerzenständer. Bewusst
// dunkel (minLevel 2 statt 7; Spawnschutz ≥ 1 sichert der Licht-Pass trotzdem). Die freie Mitte hält `reserve` (Y2,
// K3c) für das Teleskop frei; der Dachschlitz (ERW Y11 `roofOpening`) fehlt noch.
{
  id: "observatory",
  name: "Observatorium",
  minArea: 12,
  coverage: { target: 0.3 },
  // K3c (Y2): freie Mitte, nur das Teleskop darf hinein (Sternenhimmel darüber erlaubt)
  reserve: { zone: "center", size: [3, 3], reason: "focal", allow: ["telescope"] },
  required: [
    { tags: ["telescope"], count: [1, 1], signature: true, placement: { zones: ["center", "edge"], windowAffinity: "near" } },
  ],
  optional: [
    { tags: ["armillary"], count: [0, 1], weight: 3, placement: { zones: ["corner", "edge"] } },
    { tags: ["reading_table", "map_desk"], count: [0, 1], weight: 3, placement: { zones: ["edge"] } },
    { tags: ["bookshelf_wall"], count: [0, 2], weight: 2, placement: { zones: ["edge"] } },
    { tags: ["lectern"], count: [0, 1], weight: 2, placement: { zones: ["edge"] } },
    { tags: ["rug"], count: [0, 1], weight: 1, placement: { zones: ["center"] } },
    { tags: ["candle_stand"], count: [1, 3], weight: 3, placement: { zones: ["edge", "corner"] } },
    // V3 (Raumhöhe nutzen): Sternenhimmel, Kuppelrippen als Wandpfeiler bis zur Decke (O1), Kartenwand
    // FN-dense-grand: Schiffsbucht-Arkade (Steinpfeiler mit Bogen) gliedert die Längswände
    { tags: ["fn_nave_bay"], count: { perArea: 16, min: 2, max: 8 }, weight: 5, placement: { zones: ["edge"] }, pattern: { kind: "row", gap: 0 } },
    { tags: ["star_cluster"], count: [2, 4], weight: 3 },
    { tags: ["pilaster"], count: [0, 4], weight: 2, placement: { zones: ["edge"] }, pattern: { kind: "row", gap: 2 } },
    { tags: ["instrument_frames", "wall_books", "wall_shelf"], count: [1, 2], weight: 1 },
    // W2 (I6): Lesenische und Vitrine (Sammlung der Instrumente) statt der Q1a-Entwürfe fremder Räume
    { tags: ["reading_nook_corner", "display_case"], count: [0, 1], weight: 1, placement: { zones: ["corner", "edge"] } },
  ],
  lighting: { minLevel: 2, prefer: ["candles", "light_floor", "light_wall", "light_ceiling"] },
}
