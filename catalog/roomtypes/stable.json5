// Stall (R1, research/11 §8): Tiergehege mit Tor ist Pflicht (Zaun 1,5 hoch, Faktencheck #14; Tiere bringt
// der Spieler), dazu Hühnerstall mit Eier-Sammler, Vorräte, Feldgerät, Licht gegen Spawns (≥ 1 überall).
{
  id: "stable",
  name: "Stall",
  minArea: 30,
  coverage: { target: 0.45 },
  required: [
    { tags: ["animal_pen"], count: [1, 1], placement: { zones: ["center", "edge"] } },
  ],
  optional: [
    { tags: ["animal_pen"], count: { perArea: 40, min: 0, max: 2 }, weight: 3, placement: { zones: ["center", "edge"] } },
    { tags: ["egg_collector"], count: [0, 1], weight: 3, placement: { zones: ["edge", "corner"] } },
    { tags: ["barrel", "chest"], count: [0, 2], weight: 2, placement: { zones: ["corner", "edge"] } },
    { tags: ["water_cauldron"], count: [0, 1], weight: 1, placement: { zones: ["edge"] } },
    { tags: ["farm_tools"], count: [0, 2], weight: 2 },
    // V3 (Raumhöhe nutzen): Stapel, Wand über Kopfhöhe, Decke (optional, additiv)
    { tags: ["hay_stack"], count: [0, 2], weight: 3, placement: { zones: ["edge", "corner"] } },
    { tags: ["hanging_chains", "herb_rack"], count: [0, 1], weight: 1 },
    { tags: ["wall_shelf", "tool_wall"], count: [0, 2], weight: 2 },
    { tags: ["light_ceiling", "light_wall"], count: [1, 3], weight: 3 },
  ],
  lighting: { minLevel: 5, prefer: ["light_wall", "light_ceiling"] },
}
