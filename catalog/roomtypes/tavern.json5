// Taverne (research/11 §6). Pflicht: Schanktheke mit Fasswand und Wirtsgang sowie Tavernentische (je nach
// Fläche). Hocker hängen über Sockets an Theke und Tischen. Optional ein Kamin (W7-F: statt Kochstelle), Vorräte,
// Rahmen mit Essen („Menütafel“), Wandbehänge, Grün, Laternen (Kronleuchter ab lichter Höhe 5).
// K2: dichter (0.45); Festtafel mit Bänken, Spieltisch, Wandbänke, Musikecke, Wirtshaustafel/Trophäe/
// Wandteppich, Anrichte, Holzstapel, Glocke (Kerzenkreuz ab lichter Höhe 4 über `light_ceiling`).
// I2: Signatur explizit (Theke), Zone `bar` für große Räume (S2: „Theke far“, Fässer nahe der Theke).
{
  id: "tavern",
  name: "Taverne",
  minArea: 24,
  coverage: { target: 0.45 },
  required: [
    { tags: ["bar_counter"], count: [1, 1], signature: true, zone: "bar", placement: { zones: ["edge"], doorAffinity: "far" } },
    // W7-F: je 48 statt 36 Zellen ein Pflicht-Tisch – mit Hockern auf beiden Längsseiten braucht die Gruppe 2 × 4 Zellen;
    // kleine Schankstuben (60 Zellen) bekamen zwei Tische an die Wand und keine ganze Gruppe
    { tags: ["tavern_table"], count: { perArea: 48, min: 1, max: 3 }, placement: { zones: ["center"] } },
  ],
  optional: [
    // W7-F: Kamin in der Gaststube statt Küchenherd (Vorbilder: Schankraum mit Kamin an der Rück- bzw. Stirnwand, Sessel
    // davor; plan/spikes/W7F_innen.md) – ab ≈ 30 Zellen immer im Programm. Formen: decor/fireplace (Feuer erhöht bzw.
    // hinter Kupferfalltür) und arch/fireplace_wall (Feuer hinter Gitter, Feuerbank unter Haube): kein Feuer auf Laufhöhe
    { tags: ["fireplace"], count: { perArea: 60, min: 0, max: 1 }, weight: 3, placement: { zones: ["edge"] } },
    { tags: ["wing_chair"], count: [0, 1], weight: 2, placement: { zones: ["center", "edge"] }, near: { tags: ["fireplace"], maxGap: 2, facing: true } },
    { tags: ["tavern_table", "barrel_bar_table"], count: [0, 2], weight: 3, placement: { zones: ["center"] } },
    // W3-IN: Fässer und Vorräte gehören an die Theke (Fasswand, Nachschub), nicht in die Gaststube
    { tags: ["barrel", "goods"], count: [1, 3], weight: 3, zone: "bar", placement: { zones: ["corner", "edge"] }, near: { tags: ["bar_counter"], maxGap: 2 } },
    { tags: ["wall_food", "wall_banner"], count: [1, 3], weight: 3 },
    { tags: ["plant_large"], count: [0, 2], weight: 1, placement: { zones: ["corner"] } },
    { tags: ["fn_hall_table"], count: [0, 1], weight: 5, placement: { zones: ["center"] } },
    { tags: ["dining_table"], count: [0, 1], weight: 4, placement: { zones: ["center"] } },
    // FN (Innenraum-Offensive): Ecken der Gaststube belegen, Teppichinsel vor dem Kamin
    { tags: ["fn_corner"], count: [1, 3], weight: 4, placement: { zones: ["corner"] } },
    { tags: ["fn_rug"], count: [0, 1], weight: 2, placement: { zones: ["center"] }, near: { tags: ["fireplace"], maxGap: 3 } },
    // W2 (I6): Spieltisch (Schachbrett) nur noch im Spielzimmer – in Schankraum/Wohnstube wirkte er wie ein Teppich-Fleck
    { tags: ["wall_bench"], count: [0, 2], weight: 2, placement: { zones: ["edge"] } },
    { tags: ["music"], count: [0, 1], weight: 2, placement: { zones: ["edge", "corner"] } },
    { tags: ["menu_board", "trophy", "tapestry", "fn_tapestry"], count: [1, 3], weight: 3 },
    { tags: ["sideboard", "firewood"], count: [0, 1], weight: 1, zone: "bar", placement: { zones: ["edge"] } },
    { tags: ["bell"], count: [0, 1], weight: 1 },
    // V3 (Raumhöhe nutzen): Stapel, Wand über Kopfhöhe, Decke (optional, additiv)
    { tags: ["ceiling_banner"], count: [0, 2], weight: 2 },
    { tags: ["crate_stack", "barrel_stack"], count: [0, 1], weight: 2, zone: "bar", placement: { zones: ["corner", "edge"] } },
    { tags: ["wall_shelf", "upper_cabinet", "mantel_shelf_display"], count: [0, 2], weight: 2 },
    // W3-IN (I7): Hauptlicht sind die Laternen an Ketten über den Tischen (Andockpunkt der Tische, Licht-Pass); ein
    // Kronleuchter nur in großen Schankräumen statt vieler Einzel-Laternen im Raum
    { tags: ["chandelier"], count: { perArea: 60, min: 0, max: 1 }, weight: 2 },
  ],
  // W3-IN (I7): Laternen an Ketten über den Tischen, Kerzen auf den Tischen, Laternen an den Wänden; Budget je Fläche
  lighting: { minLevel: 6, prefer: ["light_pendant", "candles", "light_wall", "chandelier"], budget: { cellsPer: 10, min: 3 }, anchors: ["tavern_table", "barrel_bar_table", "dining_table", "banquet_table"] },
  // Große Tavernen (ab ≈ 96 freien Zellen, Solver v2): Schankbereich fern der Tür (Theke, Fässer, Anrichte).
  // Die Gaststube sind die übrigen Teilflächen; Tische verteilen sich dort reihum (Gruppen statt Raster).
  zones: [{ id: "bar", doorAffinity: "far" }],
}
