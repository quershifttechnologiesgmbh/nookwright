// Gartenwiese (W4 27.09.2026, plan/spikes/W4A_zaeune.md): wie die Wiese (`meadow`), aber Wege aus Trittsteinen im
// Rasen – Cottage- und Hobbit-Gärten (Vorbilder: Trittsteine von der Tür zum Rand, viel Rasen, Zaun nur vorn).
// Standard des Hobbit-Erdhauses (`catalog/buildingtypes/hobbit.json5`).
{
  id: "cottage",
  name: "Gartenwiese",
  description: "Sanfte Wiese mit Trittstein-Wegen, Vorgartenzaun, Baumgruppen und Blumen im Saum",
  relief: { amplitude: 2, scale: 28, octaves: 3, gain: 0.5 },
  soil: { depth: 3 },
  lighting: { mode: "paths", every: { main: 8, side: 12 }, entry: true },
  foundation: { pad: 1, blend: 6 },
  // Trittsteine im Schachbrett (je Reihe ein Stein, versetzt), Hauptweg 2 breit, Nebenwege 1 breit
  paths: { profile: { main: 2, side: 1, edge: 0, median: false, stepping: true, steppingAll: true, forecourt: 6 } },
  fences: { lanterns: "gate", street: true, logEvery: 12, streetSpan: "front" },
  decor: { well: "roofed", beds: true, kits: true },
  vegetation: {
    trees: { spacing: 9, density: 0.15, threshold: 0.45, species: { oak: 60, birch: 30, spruce: 10 },
      groups: { size: [2, 3], every: 96, rim: [2, 6], understory: 1, max: 4 } },
    bushes: { spacing: 7, density: 0, foundation: 0.55 },
    ground: { spacing: 1, density: 0.95, threshold: 0.3, flowers: 0.7, carpet: 0.1,
      clusters: { spacing: 4, radius: [1, 3], core: 0.85, edge: 0.3 },
      near: { distance: 3, open: 0.2 } },
    keepFree: [{ along: "path", distance: 1 }, { around: "door", distance: 5 }],
  },
}
