// Gehöft (research/18 S1): sanftes Flachland mit Wegprofil, Pfostenzäunen, Hecken, Brunnenhaus, Hof-Ausstattung
// und Laternen im Takt. Zusammen mit der Vorlage `homestead` (Site.applyTemplate) die „Ein-Klick-Umgebung“.
{
  id: "homestead",
  name: "Gehöft",
  description: "Hof mit Brunnenhaus, Feld mit Pfostenzaun, Heckengarten, Obstgarten, Koppel, Laternen entlang der Wege",
  // Q3: freie Landschaft – Gehöft: Blumen am Haus, einzelne Steine (L3: Mitte zwischen Wald und Wiese).
  // W1-I (26.09.2026, W1E M1 „Grundstück zugemüllt“): keine freie Landschaft mehr. Vorher 115–137 zufällige Objekte je
  // Grundstück, davon 55–68 % Beet-Klötze (Erdlage auf dem Gras) und 13–35 tote Bäume auf dem Wohngrundstück.
  // Gezielt platziert bleibt alles, was einen Ort hat: Hof mit Brunnen, Garten mit Beeten in Reihen, Feld, Koppel,
  // Obstgarten, Holzstapel unter der Traufe, Beete mit Kante an der Hauswand, Laternen am Weg. Blumen wachsen direkt
  // im Rasen (`vegetation.ground`).
  relief: { amplitude: 1, scale: 36, octaves: 2, gain: 0.5 },
  soil: { depth: 3 },
  foundation: { pad: 1, blend: 5 },
  // G1: Dorfweg 3 (Kies/grobe Erde) zur Zufahrt, Nebenwege 2, Pfade als Trittsteine, weicher Rand
  // W3 (27.09.2026, Grundstücks-Module, plan/spikes/W3GA_grundstueck.md, 25 Vorbilder): Weg stößt direkt ans Gras,
  // Rand ±1 ausgefranst im Wegmaterial (`bulge`, 10/12 Vorbildern) statt Erdflecken (`edge` 0); Straßenzaun mit Tor
  // genau über dem Hauptweg und Laternen nur auf den Torpfosten (Öffnung in der Wegachse 4/4, Licht an jedem Pfosten
  // 0/16); Zonen als feste Module (Hofecke, Gartenecke …, `kits`); Baumgruppen an den Ecken und hinter dem Haus, nie
  // vor einer Fassade (0/16); Büsche nur als Unterholz und am Fundament; Blumen im Saum (`near`).
  // W4 (27.09.2026, Review M3): Vorplatz 3 × 6 vor der Tür als Pflaster aus einer Rolle (≤ 3 Blockarten)
  paths: { profile: { main: 3, side: 2, edge: 0, bulge: 0.3, median: false, stepping: true, forecourt: 6 } },
  // Z1: Stammpfosten alle 4 Felder
  // W4 (27.09.2026, plan/spikes/W4A_zaeune.md): schlanke Zaunlinie – Zwischenpfosten sind Zaun 2 hoch, Stamm nur an
  // Ecken, Enden und höchstens alle 12 Felder (Stumpf mit Zaunkopf), die Torpfosten bleiben Stämme mit Laterne;
  // Straßenzaun nur vor dem Haus (Vorgartenzaun), nicht mehr parallel zum Koppelzaun über die ganze Seite
  fences: { postEvery: 4, logEvery: 12, lanterns: "gate", street: true, streetSpan: "front" },
  // L1: Laternenpfähle an Kreuzungen und alle 10 Blöcke; Leuchtbüsche im Modus „spawnsicher“ (L3)
  lighting: { mode: "paths", every: { main: 10, side: 12 }, leaves: true, entry: true },
  decor: {
    well: "roofed",
    props: 0.8,
    scatter: 0.4,
    planters: true,
    beds: true,
    eaves: true,
    houseTrees: 2,
    espalier: true,
    kits: true,
  },
  vegetation: {
    // W1-I (26.09.2026): wenige Bäume in Gruppen (harte Schwelle 0,5 auf der Waldmaske, Dichte 0,35 → 0,1; die
    // gezielten Bäume – Obstgarten, Hausbäume – bleiben) und halb so viele Einzelbüsche; Fundament-Büsche bleiben
    trees: { spacing: 10, density: 0.1, threshold: 0.5, species: { oak: 70, birch: 30 },
      // W4: höchstens 4 Bäume aus Gruppen und Hausbäumen (Vorbilder 2–4; der Obstgarten zählt als Zone nicht mit)
      // W12-C (Review R6-4 „Birke vor dem Wohnhaus“): Sichtkeil 70° (Halbwinkel) vor der Haustür bleibt baumfrei – Bäume rahmen den
      // Hof seitlich und dahinter (homedit.com: Bäume seitlich des Eingangs, nie davor)
      groups: { size: [2, 3], every: 120, rim: [2, 6], understory: 1, max: 4, sight: 70 } },
    bushes: { spacing: 8, density: 0, foundation: 0.5 },
    ground: { spacing: 1, density: 0.45, threshold: 0.35, flowers: 0.35, carpet: 0.08,
      // Q3: Blumen in Flecken mit dichtem Kern (research/51 §4)
      clusters: { spacing: 5, radius: [1, 3], core: 0.9, edge: 0.25 },
      near: { distance: 3, open: 0.2 } },
    // Wege und Türvorfelder bleiben frei, egal wie dicht gestreut wird (research/30 K6); W1-I: Vorplatz vor der Tür
    // 2 → 5 frei, damit Tür und Weg lesbar sind
    keepFree: [{ along: "path", distance: 1 }, { around: "door", distance: 5 }],
    orchard: { spacing: 5 },
  },
}
