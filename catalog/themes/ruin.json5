// Verfallen / Ruine (research/24 §7.7, T7): bewusst unruhig, Risse und Moos, Schutt statt Ordnung.
// Erbt von medieval und überschreibt Wände, Böden, Dach, Gründung und Außenwelt.
// Kernthemes: (a) Mauerbruch, (b) verfallenes Kloster, (c) Deckenloch, (d) Schutthof.
// Falle (research/24 §7.7): zerfallene Flächen brauchen trotzdem eine lesbare Grundfläche – der Zufall liegt in
// den Flecken (cells mit kleiner Zelle), nicht in der Auswahl der Blöcke.
{
  id: "ruin",
  // feat/theme-moods: Stimmungs-Vorgabe (wirkt nur mit eingeschalteter Stimmung, siehe plan/spikes/F_theme_moods.md §4)
  mood: { wear: 0.75, richness: -0.5, organic: 0.5 },
  name: "Ruine",
  description: "Rissige Steinziegel, Moos in großen Flecken, Schuttboden, hohes Alter",
  base: "medieval",
  roles: {
    // P1 Mauerbruch: kleine Zellen = unruhiger Verband, harte Kanten
    // W2 Regel W5: der Verfall läuft über die ganze Fassade (Sockel → Traufe), nicht je Geschoss neu
    // W13-F (28.09.2026): ruhiger – Steinziegel tragen, rissige als Viertel, Bruchstein am Fuß; das Moos macht die
    // Verwitterung (decor), nicht die Mischung (game.guide/minecraft-ruins: 50/25/25 Stein/rissig/bemoost; „too much
    // variation looks catastrophic“, blockblend medieval guide: ~15 % bemoost/rissig). Vorher vier Steine je Stopp in 2er-Zellen
    // (Tarnmuster) und Tiefenschiefer-Flecken.
    wall_primary: {
      gradient: {
        along: "facade_h",
        jitter: 0.15,
        interpolate: "ease",
        stops: [
          { at: 0, mix: [
            { family: "cobblestone", weight: 55 },
            { family: "stone_bricks", weight: 45 },
          ] },
          { at: 0.5, mix: [
            { family: "cobblestone", weight: 15 },
            { family: "stone_bricks", weight: 70 },
            { family: "stone_bricks", variant: "cracked", weight: 15 },
          ] },
          { at: 1, mix: [
            { family: "stone_bricks", weight: 75 },
            { family: "stone_bricks", variant: "cracked", weight: 25 },
          ] },
        ],
      },
      noise: { type: "cells", cell: 3 },
    },
    // W13-F: Innenwand Steinziegel mit wenig Rissen/Moos, ohne Kalzit-Flecken
    wall_secondary: {
      mix: [
        { family: "stone_bricks", weight: 65 },
        { family: "stone_bricks", variant: "cracked", weight: 20 },
        { family: "stone_bricks", variant: "mossy", weight: 15 },
      ],
      noise: { type: "cluster", scale: 3, octaves: 2 },
    },
    floor_primary: {
      // W4 (27.09.2026, Review M6 „Tarnmuster“): Dielen in Reihen statt großer Flecken – nur Bretter (keine entrindeten
      // Hölzer mit Maserung quer zur Diele), ein Hauptholz ≥ 75 % (Ruine) bzw. ≥ 86 %, Nachbartöne nur als ganze Bretter
      // (`noise.boards`: Wahl je Brett aus 4 Blöcken, Reihen versetzt). Sprenkel innen < 15 %.
      mix: [
        { family: "spruce", weight: 75 },
        { family: "dark_oak", weight: 25 },
      ],
      noise: { type: "cluster", scale: 3, octaves: 1, boards: 4 },
    },
    // Schuttboden: Bruchstein, rissige Ziegel und Moos in kleinen Zellen
    floor_stone: {
      mix: [
        { family: "stone_bricks", weight: 45 },
        { family: "cobblestone", weight: 35 },
        { family: "stone_bricks", variant: "cracked", weight: 20 },
      ],
      noise: { type: "cells", cell: 3 },
    },
    floor_earth: {
      mix: [
        { block: "minecraft:coarse_dirt", weight: 40 },
        { block: "minecraft:rooted_dirt", weight: 30 },
        { block: "minecraft:packed_mud", weight: 30 },
      ],
      noise: { type: "cluster", scale: 2.5, octaves: 2 },
    },
    floor_border: { family: "spruce" },
    floor_strip: { family: "dark_oak" },
    // Sockel (W7, zwei Steine)
    // W13-F: Fundament Bruchstein, bemoost (ohne Tiefenschiefer-Flecken)
    foundation: {
      mix: [
        { family: "cobblestone", weight: 70 },
        { family: "mossy_cobblestone", weight: 30 },
      ],
      noise: { type: "cluster", scale: 3, octaves: 2 },
    },
    beam: { family: "dark_oak", shapes: { log: "stripped_log", wood: "stripped_wood" } },
    pillar: { family: "stone_bricks" },
    door: { family: "spruce" },
    ceiling: {
      mix: [
        { family: "spruce", weight: 50 },
        { family: "dark_oak", weight: 30 },
        { family: "spruce", variant: "stripped_wood", weight: 20 },
      ],
      noise: { type: "cluster", scale: 3, octaves: 2 },
    },
    // Eingestürztes Dach: der Verfall kommt aus der Erosion (Löcher, `decor.ruin`), die Deckung selbst bleibt ein
    // lesbares Rezept (W2 Regel D1) – Tiefenschieferfliesen, am Traufring der rauere Bruch-Tiefenschiefer
    // W13-F: verrottetes Holzdach (dunkle Eiche an der Traufe, Fichte darüber, Flecken) über grauem Stein – „roof mostly
    // missing, partial dark oak or spruce“ (game.guide/minecraft-ruins). Vorher Tiefenschiefer wie medieval.
    roof_main: {
      gradient: {
        along: "roof_t",
        quantize: "ring",
        interpolate: "step",
        patch: 0.04,
        stops: [
          { at: 0, mix: [{ family: "dark_oak", weight: 1 }] },
          { at: 0.3, mix: [{ family: "spruce", weight: 1 }] },
          { at: 1, mix: [{ family: "spruce", weight: 1 }] },
        ],
      },
    },
    roof_trim: { family: "cobblestone" },
    wall_plinth: {
      mix: [
        { family: "cobblestone", weight: 40 },
        { family: "mossy_cobblestone", weight: 35 },
        { family: "stone_bricks", weight: 25 },
      ],
      noise: { type: "cells", cell: 3 },
    },
    wall_cornice: { family: "mossy_stone_bricks" },
    // Eckquader (W3) mit Helligkeitsabstand: rissige Tiefenschieferziegel statt rissiger Steinziegel (gleich hell wie die Wand)
    // W13-F: Eckquader rissige Steinziegel (vorher rissige Tiefenschieferziegel, dunkle Streifen)
    wall_quoin: { family: "stone_bricks", shapes: { block: "cracked" } },
    shutter: { family: "spruce" },
    furniture_wood: { family: "spruce" },
    metal: { family: "iron" },
    textile_primary: { color: "gray" },
    textile_accent: { color: "brown" },
    textile_neutral: { color: "light_gray" },

    // ---------------------------------------------------------------- Außen: überwuchert, Schutt, Unkraut
    ground_grass: {
      mix: [
        { block: "minecraft:grass_block", weight: 40 },
        { block: "minecraft:coarse_dirt", weight: 25 },
        { block: "minecraft:podzol", weight: 20 },
        { block: "minecraft:moss_block", weight: 15 },
      ],
      noise: { type: "cells", cell: 3 },
    },
    ground_path: {
      mix: [
        { block: "minecraft:cobblestone", weight: 35 },
        { block: "minecraft:mossy_cobblestone", weight: 30 },
        { block: "minecraft:dirt_path", weight: 20 },
        { block: "minecraft:stone", weight: 15 },
      ],
      noise: { type: "cells", cell: 2 },
    },
    ground_yard: {
      mix: [
        { block: "minecraft:mossy_cobblestone", weight: 40 },
        { block: "minecraft:cobblestone", weight: 30 },
        { block: "minecraft:cracked_stone_bricks", weight: 20 },
        { block: "minecraft:stone_bricks", weight: 10 },
      ],
      noise: { type: "cells", cell: 2 },
    },
    leaves_oak: { family: "oak" },
    leaves_bush: {
      mix: [
        { block: "minecraft:azalea_leaves", weight: 35 },
        { block: "minecraft:oak_leaves", weight: 35 },
        { block: "minecraft:flowering_azalea_leaves", weight: 30 },
      ],
    },
    flower_wild: {
      mix: [
        { block: "minecraft:poppy", weight: 30 },
        { block: "minecraft:cornflower", weight: 25 },
        { block: "minecraft:oxeye_daisy", weight: 25 },
        { block: "minecraft:allium", weight: 20 },
      ],
    },
    grass_tuft: {
      mix: [
        { block: "minecraft:fern", weight: 40 },
        { block: "minecraft:short_grass", weight: 35 },
        { block: "minecraft:bush", weight: 25 },
      ],
    },
    ground_cover: {
      mix: [
        { block: "minecraft:leaf_litter", weight: 45 },
        { block: "minecraft:moss_carpet", weight: 30 },
        { block: "minecraft:pink_petals", weight: 25 },
      ],
    },
    hedge: { family: "oak" },
  },
  // Innenhaut (W2-FD): eine Ruine ist verfallen – keine Täfelung, das Mauerwerk bleibt innen sichtbar
  lining: [{ off: true }],













  // Farbwelt-Anschluss (research/54 §3.2): welche Theme-Rolle eine Palette ersetzt. Jede Theme-Rolle nur
  // einmal; nicht genannte Rollen (Tueren, Deckenbalken, Moebelholz) behalten ihre Theme-Farbe.
  paletteRoleMap: {
    wall_primary: ["wall_primary", "foundation"],
    wall_secondary: ["wall_secondary"],
    trim: ["wall_cornice", "wall_quoin", "wall_plinth"],
    roof: ["roof_main"],
    roof_accent: ["roof_trim"],
    wood_frame: ["beam", "pillar"],
    floor: ["floor_primary", "floor_stone", "floor_earth", "ground_grass", "ground_path", "ground_yard"],
    accent: ["textile_primary", "textile_accent", "textile_neutral"],
    glass: ["shutter"],
    foliage: ["leaves_oak", "leaves_bush", "flower_wild", "grass_tuft", "ground_cover", "hedge"],
  },

  decor: {
    // Alter 0,7: Moos und Risse dominieren, mit breiter Randzone (fade 2)
    weathering: { age: 0.7, fade: 2, roles: ["wall_primary", "wall_secondary", "foundation", "floor_stone", "wall_plinth"] },
    // Erosion der Silhouette (research/50 C1): ~30 % der Spalten verlieren 1–3 Zellen von oben. Damit bricht
    // zuerst das Dach (Löcher), bei tieferem Cap auch die Mauerkrone (zackige Traufe); die Traufe selbst bleibt
    // ab roof_t 0,3 stehen. Der Bau bleibt erkennbar (rund ein Zehntel der Zellen).
    ruin: {
      roles: ["wall_primary", "wall_secondary", "wall_plinth", "wall_cornice", "wall_quoin", "beam", "pillar", "roof_main", "roof_trim", "ceiling", "foundation"],
      chance: 0.3,
      maxDrop: 3,
      minRoofT: 0.3,
    },
  },
  items: {
    "food.any": ["minecraft:bread", "minecraft:rotten_flesh", "minecraft:apple", "minecraft:mushroom_stew"],
    "deco.small": ["minecraft:bone", "minecraft:string", "minecraft:cobweb"],
  },
}
